<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
android:key="root">
    <CheckBoxPreference
        android:title="@string/wifi_only_title"
        android:summary="@string/wifi_only_desc"
        android:key="wifi_only"
        android:defaultValue="false"
        android:order="10"/>
    <ListPreference
        android:key="quality"
        android:entries="@array/quality_labels"
        android:entryValues="@array/quality_values"
        android:defaultValue="std"
        android:title="@string/speech_quality"
        android:dialogTitle="@string/speech_quality"
        android:summary="%s"
        android:order="20"/>
    <CheckBoxPreference
        android:title="Kiril harflarini rus ovozida o'qish"
        android:summary="Yoqilganda, matndagi kiril harflari avtomatik ravishda rus ovozida o'qiladi (rus ovozi o'rnatilgan bo'lishi kerak)"
        android:key="custom_cyrillic_to_russian"
        android:defaultValue="false"
        android:order="15"/>
    <Preference
        android:title="Til tanlang"
        android:summary="Ilovalar bo'yicha alohida o'qish tilini belgilash"
        android:key="custom_language_picker"
        android:persistent="false"
        android:order="16">
        <intent
            android:targetPackage="com.github.olga_yakovleva.rhvoice.android.uz"
            android:targetClass="com.github.olga_yakovleva.rhvoice.android.AppLanguagePickerActivity"/>
    </Preference>
    <Preference
        android:title="Foydalanish ruxsatini yoqish"
        android:summary="Ilova bo'yicha til ishlashi uchun 'Foydalanish ma'lumotlariga kirish' ruxsatini shu yerdan yoqing"
        android:key="custom_usage_access"
        android:persistent="false"
        android:order="17">
        <intent android:action="android.settings.USAGE_ACCESS_SETTINGS"/>
    </Preference>
    <SwitchPreferenceCompat
        android:title="@string/config_file"
        android:key="config_file"
        android:persistent="false"
        android:defaultValue="false"
        android:order="199"
        app:isPreferenceVisible="false"/>
    <Preference
        android:key="version"
        android:persistent="false"
        android:title="@string/version"
        android:order="200"/>
</PreferenceScreen>
